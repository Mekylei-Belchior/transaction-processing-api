<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>

    <conversionRule
            conversionWord="mascarado"
            converterClass="com.mekylei.transactionprocessing.observabilidade.logging.LogMascaramentoConverter"/>

    <!-- ========================= -->
    <!-- Produção                  -->
    <!-- ========================= -->
    <springProfile name="prod">

        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">

            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">

                <providers>

                    <timestamp>
                        <fieldName>timestamp</fieldName>
                    </timestamp>

                    <logLevel>
                        <fieldName>level</fieldName>
                    </logLevel>

                    <loggerName>
                        <fieldName>logger</fieldName>
                    </loggerName>

                    <threadName>
                        <fieldName>thread</fieldName>
                    </threadName>

                    <provider
                            class="com.mekylei.transactionprocessing.observabilidade.logging.MascaradoJsonProvider">
                        <fieldName>message</fieldName>
                        <tipo>MESSAGE</tipo>
                    </provider>

                    <provider
                            class="com.mekylei.transactionprocessing.observabilidade.logging.MascaradoJsonProvider">
                        <fieldName>stacktrace</fieldName>
                        <tipo>STACKTRACE</tipo>
                    </provider>

                    <!-- idCorrelacao, traceId, spanId, usuarioId, etc -->
                    <mdc>
                        <includeMdcKeyName>idCorrelacao</includeMdcKeyName>
                    </mdc>

                </providers>

            </encoder>

        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

    </springProfile>

    <!-- ========================= -->
    <!-- Desenvolvimento           -->
    <!-- ========================= -->
    <springProfile name="dev">

        <appender name="CONSOLE"
                  class="ch.qos.logback.core.ConsoleAppender">

            <encoder>
                <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss}){faint} %clr([%thread]){cyan} %clr([%X{idCorrelacao:-sem-correlacao}]){magenta} %clr(%-5level) %clr(%logger{36}){green} %clr(-){faint} %mascarado%n
                </pattern>
            </encoder>

        </appender>

        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>

    </springProfile>

    <!-- Redução de ruído de frameworks -->
    <logger name="org.springframework" level="WARN"/>

    <logger name="org.hibernate" level="WARN"/>

    <logger name="org.apache.catalina" level="WARN"/>

    <logger name="org.apache.tomcat" level="WARN"/>

</configuration>