# .env.example — Copie para .env e preencha com seus valores locais

# === Banco de Dados ===
POSTGRES_DB=transacaodb
DB_URL=jdbc:postgresql://localhost:5432/transacaodb
DB_USERNAME=postgres
DB_PASSWORD=password

# === Perfil e Porta ===
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# === OAuth2 / Keycloak ===
# Para usar o Keycloak local, substitua https://keycloak.lab.home por http://localhost:8180 nas duas URLs abaixo.
OAUTH2_JWKS_URI=https://keycloak.lab.home/realms/bancario/protocol/openid-connect/certs
OAUTH2_ISSUER_URI=https://keycloak.lab.home/realms/bancario

# === Criptografia AES-256-GCM ===
APP_CRIPTOGRAFIA_CHAVE=<GERE_COM_OPENSSL_VER_ABAIXO>
# Gere uma chave AES-256-GCM em Base64 com: openssl rand -base64 32

# === HMAC-SHA256 ===
APP_HMAC_CHAVE=<GERE_COM_OPENSSL_VER_ABAIXO>
# Gere uma chave HMAC-SHA256 em Base64 com: openssl rand -base64 32

# === Rate Limiting ===
RATE_LIMIT_REQUISICOES_POR_MINUTO=300

# === Antifraude ===
ANTIFRAUDE_LIMITE_APROVACAO_AUTOMATICA=10000.00

# === Kafka ===
# Mantenha desabilitado para executar localmente sem um broker Kafka.
EVENTOS_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka.lab.home:9094
KAFKA_USERNAME=<USUARIO_SASL_SCRAM>
KAFKA_PASSWORD=<SENHA_SASL_SCRAM>
KAFKA_SSL_TRUSTSTORE_LOCATION=file:/<CAMINHO>/kafka-client-truststore.p12
KAFKA_SSL_TRUSTSTORE_PASSWORD=<SENHA_DO_TRUSTSTORE>
KAFKA_SSL_TRUSTSTORE_TYPE=PKCS12

# === Outbox / DLQ ===
EVENTOS_KAFKA_DLQ_MAX_TENTATIVAS=3
EVENTOS_KAFKA_DLQ_INTERVALO_REPROCESSAMENTO=10s
EVENTOS_OUTBOX_LOTE_PUBLICACAO=50
EVENTOS_OUTBOX_INTERVALO_PUBLICACAO_MS=5000
EVENTOS_OUTBOX_INTERVALO_REPROCESSAMENTO=30s
EVENTOS_OUTBOX_TIMEOUT_ENVIO_MS=5000

# === OTLP / Jaeger ===
OTLP_TRACING_ENDPOINT=https://otlp-jaeger.lab.home/v1/traces
